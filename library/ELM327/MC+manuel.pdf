         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>vLinker MC Quick Start Guide</photoshop:LayerName>
                  <photoshop:LayerText>vLinker MC Quick Start Guide</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>for Android and windows</photoshop:LayerName>
                  <photoshop:LayerText>for Android and windows</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>1ã€what OBDII Protocols does vLinker MC          supports?</photoshop:LayerName>
                  <photoshop:LayerText>1ã€what OBDII Protocols does vLinker MC          supports?</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName> SAE J1850 PWM             SAE J1850 VPW             ISO 9141-2</photoshop:LayerName>
                  <photoshop:LayerText> SAE J1850 PWM             SAE J1850 VPW             ISO 9141-2  ISO 14230-4(slow)         ISO 14230-4(fast)   ISO 15765-4(CAN)         SAE J1939(CAN)            ISO 11898(raw can)   Single Wire CAN(GMLAN)          Medium Speed CAN(MS-CAN)</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>2ã€Download&amp;install APP</photoshop:LayerName>
                  <photoshop:LayerText>2ã€Download&amp;install APP</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Torque Lite and OBD&lt;most popular.Lite version is free&gt;  OBD Aut</photoshop:LayerName>
                  <photoshop:LayerText>Torque Lite and OBD&lt;most popular.Lite version is free&gt;  OBD Auto Doctor&lt;Excellent Free app, Upgrade to Pro in-app&gt;  OBD Fusion&lt;Excellent 3rd party app&gt;  bimmercode&lt;download from google play of Android&gt;</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>     allows you to code the control units in your BMW or mini t</photoshop:LayerName>
